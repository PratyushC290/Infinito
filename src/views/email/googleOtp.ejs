<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Your OTP Code</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f9f9f9;
            margin: 0;
            padding: 0;
        }
        .container {
            background-color: #ffffff;
            max-width: 500px;
            margin: 40px auto;
            border-radius: 8px;
            padding: 20px;
            border: 1px solid #e0e0e0;
        }
        h2 {
            color: #333333;
        }
        .tempPassword {
            font-size: 24px;
            font-weight: bold;
            color: #2196f3;
            background: #f0f8ff;
            padding: 10px 20px;
            display: inline-block;
            border-radius: 4px;
            letter-spacing: 2px;
        }
        p {
            color: #555555;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>Hello <%= name %>,</h2>
        <p>Here is your temporary for login:</p>
        <div class="tempPassword"><%= tempPassword %></div>
        <p>If you did not request this, please ignore this email.</p>
        <p>— Best Regards</p>
        <p>— Team <%= settings.siteName %> !!</p>
    </div>
</body>
</html>
